{
  "name": "lexiconned-server",
  "version": "1.0.0",
  "private": true,
  "description": "WebSocket backend for Lexiconned Party's networked (online) multiplayer mode.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "gen:data": "node scripts/gen-data.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
